# Use a URL agrupada do Neon (host contendo -pooler) na aplicacao.
DATABASE_URL=postgresql+psycopg://usuario:senha@host-pooler.neon.tech/neondb?sslmode=require

# Nunca reutilize estes valores de exemplo. Cadastre segredos exclusivos na Vercel.
FUTSYSTEM_ADMIN_PASSWORD=substitua-por-uma-senha-forte
FUTSYSTEM_JWT_SECRET=substitua-por-um-segredo-aleatorio-com-ao-menos-32-caracteres
FUTSYSTEM_REGISTRATION_CODE=substitua-por-um-codigo-de-convite-com-8-a-64-caracteres
